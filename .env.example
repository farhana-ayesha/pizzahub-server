NODE_ENV=development
PORT=4000

# MongoDB connection. Use a local instance or a hosted Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/pizzahub
MONGODB_DB_NAME=pizzahub

# Better Auth. Use long random values in every deployed environment.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public origin where /api/auth is reachable. The Next.js client proxies
# /api/auth/* to this server, so this must be the CLIENT origin, not the API
# host. Google's callback URL is {BETTER_AUTH_URL}/api/auth/callback/google.
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# Extra allowed client origins, comma separated, for preview deployments.
CLIENT_URLS=

# JWT access tokens issued by GET /api/auth/token.
JWT_SECRET=replace-with-another-at-least-32-character-secret
JWT_EXPIRES_IN=7d

# Google OAuth (optional). Authorized redirect URI:
# {BETTER_AUTH_URL}/api/auth/callback/google
# Authorized JavaScript origin: {BETTER_AUTH_URL}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe subscriptions (required for Premium checkout and webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use an existing recurring Price instead of the inline $29 price.
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_AMOUNT=2900
STRIPE_CURRENCY=usd

# ImgBB menu image uploads. The key is used only on the server.
IMGBB_API_KEY=

# Seed admin. Change these values before running npm run seed in production.
ADMIN_NAME=PizzaHub Admin
ADMIN_EMAIL=admin@pizzahub.com
ADMIN_PASSWORD=Password123

# Password reset emails (optional).
RESEND_API_KEY=
EMAIL_FROM=PizzaHub <noreply@pizzahub.com>
RESET_PASSWORD_URL=

# Set to false to seed only the admin account.
SEED_DEMO_DATA=true
